# ==============================================================================
# NEXORA ENVIRONMENT VARIABLES TEMPLATE
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# Duplicate this file to .env.local for local development
# ==============================================================================

# SUPABASE CONFIGURATION
# Found in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# APPLICATION HOSTS
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# EXPO MOBILE CONFIGURATION
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key-here
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# AI PROVIDERS (Server-side / Edge functions only)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# PAYMENT GATEWAYS (Server-side only)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
BKASH_APP_KEY=your_bkash_app_key_here
BKASH_APP_SECRET=your_bkash_app_secret_here

# NOTIFICATIONS & PUSH SERVICES
EXPO_ACCESS_TOKEN=your_expo_access_token_here
RESEND_API_KEY=your_resend_api_key_here
SYSTEM_FROM_EMAIL=notifications@nexora.com

# SECURITY & RATE LIMITING
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here
ADMIN_MFA_ENFORCED=true
ENVIRONMENT=development

